# ============================================================
# .gitignore — Aranda Electrics
# ============================================================
# --- Backups manuales ---
*.bak
*.orig
*.rej
# --- SO / basura del escritorio ---
.DS_Store
._*
.Thumbs.db
Thumbs.db
desktop.ini
.directory
.Trash-*
.fuse_hidden*
*~
# --- Editores / IDEs ---
.vscode/
!.vscode/extensions.json
.idea/
*.swp
*.swo
*.sublime-workspace
*.sublime-project
# --- Node / tooling frontend (por si añades build más adelante) ---
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
.pnpm-store/
package-lock.json.bak
.npm/
# --- Build outputs / cachés ---
dist/
build/
out/
.cache/
.parcel-cache/
.next/
.nuxt/
.svelte-kit/
coverage/
# --- Variables de entorno y secretos ---
.env
.env.*
!.env.example
*.pem
*.key
secrets.json
# --- Logs y temporales ---
*.log
*.tmp
*.temp
# --- Configs locales del proyecto ---
.htaccess.local
sftp-config.json
